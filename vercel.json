{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/v-master-786-private-access.html",
      "dest": "v-master-786-private-access.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
